*.py[cod]
*$py.class
*.so
venv/
.venv/
env/

# Node & frontend build artifacts
node_modules/
dist/
.vite/

# Environment files (keep .env.example)
.env
*.env.local

# Database temporary files
*.db
*.sqlite3
*.db-shm
*.db-wal

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Large Datasets
Personal Protective Equipment - Combined Model.v8i.yolov12/
buildsight-ai/backend/dataset/progress/

