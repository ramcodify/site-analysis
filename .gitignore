buildsight-ai/backend/data/uploads/*
buildsight-ai/backend/data/evidence/*
buildsight-ai/backend/data/snapshots/*
buildsight-ai/backend/runs/detect/val/*.jpg
buildsight-ai/backend/runs/detect/val/*.png
