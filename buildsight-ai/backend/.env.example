# BuildSight AI — Backend Configuration

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=buildsight_ai

# Model Paths (leave empty to use defaults or skip)
YOLO_MODEL_PATH=yolov8n.pt
PPE_MODEL_PATH=data/models/ppe_model.pt
ACTIVITY_MODEL_PATH=
PROGRESS_MODEL_PATH=

# Device Configuration
USE_CUDA=false

# Detection Settings
DETECTION_CONFIDENCE=0.5
DETECTION_IOU=0.45
MODEL_INPUT_SIZE=640

# Tracking Settings
TRACK_BUFFER=30
MATCH_THRESHOLD=0.8

# Processing Settings
MAX_PROCESSING_QUEUE=2
DEFAULT_PROCESSING_FPS=10
WORKER_SNAPSHOT_INTERVAL_SECONDS=5
PROGRESS_PERSIST_INTERVAL_SECONDS=30

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk Scoring Weights
RISK_MISSING_HELMET=25
RISK_MISSING_VEST=20
RISK_MULTIPLE_PPE=15
RISK_DANGER_ZONE=30
RISK_UNSAFE_ACTIVITY=25
RISK_REPEATED_VIOLATION=10

# Violation Settings
VIOLATION_COOLDOWN_SECONDS=30
